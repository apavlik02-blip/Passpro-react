VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Access codes are validated server-side by the `access` Edge Function against
# the service-role-only public.access_codes table — codes never appear in the
# client bundle, so there is no access-code env var here. Optional override if
# the function isn't served from VITE_SUPABASE_URL/functions/v1/access:
# VITE_ACCESS_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/access
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: only needed if the "aria" Edge Function isn't served from
# VITE_SUPABASE_URL/functions/v1/aria (the default).
# VITE_ARIA_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/aria

# Server-only keys for the 1-Minute Audio Brief API routes (Vercel / Vite dev middleware).
# Never prefix these with VITE_ — they must not reach the browser bundle.
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
